<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Starts approvals.py at 8:20 AM Central (= 9:20 AM Eastern) every day. It
  closes leftovers at the open, scans at 10:15 ET, waits for your approvals
  and sells everything by 3:55 ET. On weekends and holidays it exits right away.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.presleybarr.tradingbot.approvals</string>

    <!-- caffeinate keeps the Mac awake while it runs (lid open). -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-is</string>
        <string>/Users/presleybarr/trading bot/.venv/bin/python</string>
        <string>/Users/presleybarr/trading bot/approvals.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/presleybarr/trading bot</string>

    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>20</integer></dict>

    <key>StandardOutPath</key>
    <string>/Users/presleybarr/trading bot/logs/approvals.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/presleybarr/trading bot/logs/approvals.err.log</string>
</dict>
</plist>
