# Copy this file to .env and fill in your Alpaca paper trading keys.
# Get them at https://app.alpaca.markets -> Paper Trading -> API Keys
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_PAPER=true

# Discord channel webhook for trade alerts (Channel settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=your_webhook_url_here
